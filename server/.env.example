API_PORT=8787
NODE_ENV=development
DATA_DIR=./server/data
UPLOAD_DIR=./server/data/uploads
ADMIN_PASSWORD=change-this-password
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_CUSTOM_DOMAIN=
TENCENT_COS_SIGNED_URL_TTL=1h
TENCENT_COS_CDN_URL=
TENCENT_VOD_APP_ID=
TENCENT_VOD_PLAYBACK_KEY=
TENCENT_VOD_LICENSE_URL=
TENCENT_VOD_SIGNATURE_TTL=10m

# 反向代理会正确覆盖 X-Forwarded-For / X-Real-IP 时才开启。
TRUST_PROXY=false
# 成功的静态资源和健康检查默认不写入 SQLite，可按需开启。
ACCESS_LOG_STATIC=false
ACCESS_LOG_HEALTH=false
